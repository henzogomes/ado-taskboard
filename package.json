{
  "name": "ado-taskboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local, live Azure DevOps board taskboard (drag-and-drop + dropdown moves back to ADO).",
  "homepage": "https://github.com/henzogomes/ado-taskboard",
  "main": "electron/main.mjs",
  "desktopName": "ado-taskboard.desktop",
  "author": {
    "name": "ado-taskboard contributors",
    "email": "dev@example.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "dev:electron": "npm run build && electron .",
    "build:electron": "npm run build && electron-builder --linux AppImage pacman",
    "build:electron:deb": "npm run build && electron-builder --linux deb",
    "build:electron:mac": "npm run build && electron-builder --mac --publish never",
    "build:electron:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "pack:electron": "npm run build && electron-builder --dir",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "node scripts/electron-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test e2e/live.spec.ts",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.electron.ado-taskboard",
    "productName": "ado-taskboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "package.json",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Development",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.13",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "bash -c 'npm run typecheck'"
    ]
  }
}
